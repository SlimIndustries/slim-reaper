{
  "name": "slim-reaper",
  "productName": "Slim Reaper",
  "version": "1.3.0",
  "description": "Point it at a page. It takes every image.",
  "author": "Slim Industries <slimindustries.apps@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.slimindustries.slimreaper",
    "productName": "Slim Reaper",
    "copyright": "Slim Industries",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "build/icon.png", "build/icon.ico", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Slim Reaper",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "SlimReaper-Setup-${version}.exe"
    },
    "portable": { "artifactName": "SlimReaper-Portable-${version}.exe" }
  }
}
